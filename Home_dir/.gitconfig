[alias]
    st = status
    s  = status
    ts = status
    l  = log
    p  = push
    d  = diff
    pl = pull
    c  = commit
    co = checkout
    a  = add -u
	br = !git --no-pager branch
[user]
        name = ilyaro
        email = ilyaro@domain.com
[pull]
        rebase = true
[push]
        default = simple
        autoSetupRemote = true
[core]
        autocrlf=input
        editor=vim
	    hooksPath = /Users/ilyaro/.git-hooks
[branch]
	autoSetupMerge = simple
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper = 
	helper = !/usr/local/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/local/bin/gh auth git-credential
